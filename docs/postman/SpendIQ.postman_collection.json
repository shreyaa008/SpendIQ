{
  "info": {
    "name": "SpendIQ AI API",
    "description": "Run top to bottom (Collection Runner). Auth uses the httpOnly cookie jar and a Bearer token saved by Login. See docs/API.md.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "email",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1 \u00b7 Auth (Topic 40)",
      "item": [
        {
          "name": "Register",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status 201', () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test('returns user without password', () => { pm.expect(j.data.user.email).to.include('postman'); pm.expect(JSON.stringify(j)).to.not.include('passwordHash'); });",
                  "pm.collectionVariables.set('token', j.data.token); pm.collectionVariables.set('email', j.data.user.email);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman User\",\n  \"email\": \"postman+{{$timestamp}}@example.com\",\n  \"password\": \"Passw0rd!x\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
