# Copy to .env and fill in. NEVER commit the real .env file.
NODE_ENV=development
PORT=5000

# MongoDB: local server or a MongoDB Atlas connection string
MONGODB_URI=mongodb://127.0.0.1:27017/spendiq

# Required. At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Browser origin(s) allowed to call the API in development (comma separated)
CLIENT_ORIGIN=http://localhost:5173
# Set true behind HTTPS so the session cookie is only sent over TLS (default: true in production)
COOKIE_SECURE=false
# Serve the built client from this server (default: true in production)
SERVE_CLIENT=false

# ---- Optional: AI (Anthropic Claude) ----
# Without a key the assistant answers with rule-based text and receipts are read with local Tesseract OCR.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# auto = Claude if a key exists, otherwise Tesseract | tesseract | anthropic
RECEIPT_OCR_PROVIDER=auto

# ---- Local OCR (Tesseract) ----
TESSERACT_BIN=tesseract
TESSERACT_LANG=eng

# ---- Limits ----
UPLOAD_DIR=uploads
MAX_RECEIPT_MB=8
MAX_CSV_MB=2
CSV_MAX_ROWS=5000
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
EXPENSIVE_RATE_LIMIT_MAX=40
RECURRING_JOB_MINUTES=60